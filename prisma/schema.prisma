generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  avatar     String?
  reviews    Review[]
  activities Activity[]
  reading    Reading[]

  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Admin {
  id             String  @id @default(uuid())
  name           String
  email          String  @unique
  password       String
  avatar         String?
  authorityLevel Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Book {
  id          String     @id @default(uuid())
  title       String     @unique
  description String
  author      String
  source      String
  cover       String
  genre       String
  pages       Int
  enabled     Boolean    @default(true)
  reviews     Review[]
  activities  Activity[]

  reading   Reading[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  sentAt DateTime?

  @@unique([title, author])
}

model Review {
  id               String @id @default(uuid())
  userId           String
  userCompleteName String
  prisionName      String
  location         String
  director         String
  bookId           String

  title      String
  borrowDate DateTime
  returnDate DateTime

  approved  Boolean  @default(false)
  finished  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  book      Book     @relation(fields: [bookId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Activity {
  userId    String
  bookId    String
  page      Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  book      Book     @relation(fields: [bookId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@id([userId, bookId])
}

model Reading {
  userId   String
  bookId   String
  lastRead DateTime
  user     User     @relation(fields: [userId], references: [id])
  book     Book     @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}
