{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2021",
    "module": "commonjs",
    "typeRoots": [
      "src/@types",
      "node_modules/@types"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
  },
  "include": [
    "src",
    "src/app.ts", 
    "src/server.ts"  
  ],
  "exclude": [
    "node_modules"
  ]
}