        "summary": "Cria um usuário",
        "tags": ["User"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nome do usuário",
                  "required": ["name"]
                },
                "email": {
                  "type": "string",
                  "description": "Email do usuário",
                  "required": ["email"]
                },
                "password": {
                  "type": "string",
                  "description": "Senha do usuário",
                  "required": ["password"]
                },
                "avatar": {
                  "type": "object",
                  "description": "Avatar do usuário. É enviado como arquivo via multipart/form-data"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso"
          }
        }
      }
    },
    "/user/login": {
